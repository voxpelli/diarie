{
  "name": "diarie",
  "version": "0.1.0",
  "description": "A flat-YAML task tracker that is just files. No daemon, no database, no git hooks.",
  "author": "Pelle Wessman <pelle@kodfabrik.se> (https://kodfabrik.se/)",
  "homepage": "https://diarie.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voxpelli/diarie.git"
  },
  "bugs": {
    "url": "https://github.com/voxpelli/diarie/issues"
  },
  "keywords": [
    "task-tracker",
    "issue-tracker",
    "backlog",
    "yaml",
    "flat-file",
    "cli",
    "agents",
    "plain-text"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "bin": {
    "diarie": "cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./schema": {
      "types": "./lib/schema.d.ts",
      "default": "./lib/schema.js"
    }
  },
  "files": [
    "cli.js",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map"
  ],
  "scripts": {
    "brand:build": "run-s brand:copy brand:stamp brand:favicon",
    "brand:check": "node scripts/check-brand-assets.js",
    "brand:copy": "node brand/dist-copy.js",
    "brand:favicon": "node brand/generate-favicons.js",
    "brand:stamp": "node brand/update-stamp.js",
    "build": "npm run clean && tsc -p declaration.tsconfig.json",
    "check": "run-p check:*",
    "check:ast-grep": "ast-grep scan",
    "check:ast-grep-test": "ast-grep test",
    "check:installed-check": "installed-check",
    "check:knip": "knip",
    "check:lint": "eslint",
    "check:md": "remark . --quiet --frail --ignore-path .gitignore",
    "check:tasks": "node cli.js validate",
    "check:tsc": "tsc",
    "check:type-coverage": "type-coverage --detail --strict --at-least 98 --ignore-files 'test/*'",
    "clean": "find lib -type f \\( -name '*.d.ts' -o -name '*.d.ts.map' \\) ! -name '*-types.d.ts' -delete",
    "fix:md": "remark . -o --quiet --ignore-path .gitignore",
    "prepack": "npm run build",
    "serve": "domstack-sync --server brand --watch --port ${PORT:-3334}",
    "test": "run-s check test:*",
    "test:node": "node --test",
    "test-ci": "run-s test:*"
  },
  "dependencies": {
    "@voxpelli/typed-utils": "^5.0.0",
    "js-yaml": "^4.1.0",
    "peowly": "^1.3.3",
    "peowly-commands": "^1.1.0",
    "pony-cause": "^2.1.11"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.44.1",
    "@domstack/sync": "^0.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "@types/opentype.js": "^1.3.10",
    "@voxpelli/eslint-config": "^25.1.0",
    "@voxpelli/generate-favicon": "^1.1.1",
    "@voxpelli/tsconfig": "^16.2.1",
    "eslint": "^9.39.4",
    "installed-check": "^10.0.1",
    "knip": "^5.88.1",
    "npm-run-all2": "^7.0.2",
    "opentype.js": "^2.0.0",
    "remark-cli": "^12.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-lint-unordered-list-marker-style": "^4.0.1",
    "remark-preset-lint-consistent": "^6.0.0",
    "remark-preset-lint-recommended": "^7.0.0",
    "remark-validate-links": "^13.1.0",
    "type-coverage": "^2.29.7",
    "typescript": "~5.9.3"
  },
  "remarkConfig": {
    "settings": {
      "bullet": "-",
      "emphasis": "*",
      "strong": "*",
      "rule": "-",
      "fence": "`",
      "fences": true,
      "listItemIndent": "one"
    },
    "plugins": [
      "remark-frontmatter",
      "remark-gfm",
      "remark-preset-lint-consistent",
      "remark-preset-lint-recommended",
      "remark-validate-links",
      "remark-lint-unordered-list-marker-style"
    ]
  }
}
