{
  "name": "diarie",
  "version": "0.2.2",
  "description": "A flat-YAML task tracker that is just files. No daemon, no database, no git hooks.",
  "author": "Pelle Wessman <pelle@kodfabrik.se> (https://kodfabrik.se/)",
  "homepage": "https://diarie.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/voxpelli/diarie.git"
  },
  "bugs": {
    "url": "https://tangled.org/voxpelli.com/diarie/issues"
  },
  "keywords": [
    "task-tracker",
    "issue-tracker",
    "backlog",
    "yaml",
    "flat-file",
    "cli",
    "agents",
    "plain-text"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "bin": {
    "diarie": "cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./schema": {
      "types": "./lib/schema.d.ts",
      "default": "./lib/schema.js"
    }
  },
  "files": [
    "cli.js",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map"
  ],
  "scripts": {
    "brand": "run-s brand:*",
    "brand:1-copy": "node brand/dist-copy.js",
    "brand:2-stamp": "node brand/update-stamp.js",
    "brand:3-favicon": "node brand/generate-favicons.js",
    "brand:4-size": "node brand/stamp-size.js",
    "brand-check": "node scripts/check-brand-assets.js",
    "build": "run-s build:*",
    "build:0": "run-s clean",
    "build:1-declaration": "tsc -p declaration.tsconfig.json",
    "check": "run-p check:*",
    "check:ast-grep": "ast-grep scan --globs '!.design-sync/**' --globs '!.impeccable/**'",
    "check:ast-grep-test": "ast-grep test",
    "check:installed-check": "installed-check -i @voxpelli/remark-preset -i npm-run-all2",
    "check:knip": "knip",
    "check:lint": "eslint",
    "check:md": "remark . --quiet --frail --ignore-path .gitignore",
    "check:tasks": "node cli.js validate",
    "check:tsc": "tsc",
    "check:type-coverage": "type-coverage --detail --strict --at-least 98 --ignore-files 'test/*'",
    "clean": "find lib -type f \\( -name '*.d.ts' -o -name '*.d.ts.map' \\) ! -name '*-types.d.ts' -delete",
    "dev": "run-s brand serve",
    "fix": "run-s fix:*",
    "fix:ast-grep": "run-s check:ast-grep -- --update-all",
    "fix:lint": "eslint --fix",
    "fix:md": "remark . -o --quiet --ignore-path .gitignore",
    "prepack": "run-s build",
    "serve": "domstack-sync --server brand --watch --port ${PORT:-3334}",
    "test": "run-s check test:*",
    "test:node": "node --test",
    "test-ci": "run-s test:*"
  },
  "dependencies": {
    "@voxpelli/typed-utils": "^5.0.0",
    "js-yaml": "^4.1.0",
    "peowly": "^1.3.3",
    "peowly-commands": "^1.1.0",
    "pony-cause": "^2.1.11",
    "type-fest": "^5.8.0"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.44.1",
    "@domstack/sync": "^0.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "@types/opentype.js": "^1.3.10",
    "@voxpelli/ast-grep-rules": "^0.1.0",
    "@voxpelli/eslint-config": "^25.1.0",
    "@voxpelli/generate-favicon": "^1.1.1",
    "@voxpelli/remark-preset": "^0.1.1",
    "@voxpelli/tsconfig": "^16.2.1",
    "eslint": "^9.39.4",
    "hast-util-from-html": "^2.0.3",
    "installed-check": "^10.0.1",
    "knip": "^6.29.0",
    "npm-run-all2": "^9.0.3",
    "opentype.js": "^2.0.0",
    "remark-cli": "^12.0.0",
    "type-coverage": "^2.30.1",
    "typescript": "^6.0.3"
  },
  "remarkConfig": {
    "plugins": [
      "@voxpelli/remark-preset"
    ]
  }
}
